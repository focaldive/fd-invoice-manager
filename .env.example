# Postgres (Phase 0 — Drizzle migration)
DATABASE_URL=postgresql://admin:fd1234@localhost:5432/fd_invoice

# Auth — used in Phase 5 (cookie session)
SESSION_SECRET=
SESSION_COOKIE_NAME=
AUTH_USERNAME=
AUTH_PASSWORD=

# Integrations — set these to your real keys before running the email/whatsapp routes
RESEND_API_KEY=
WHAPI_API_TOKEN=

# Accounts sheet sync (FD-Accounts Google Sheet → /accounts + dashboard cash flow)
LEDGER_SHEET_ID=
LEDGER_SHEET_TAB=Sheet1
LEDGER_SYNC_INTERVAL_MINUTES=10
# Either a path to the service account JSON key…
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# …or the two fields from it (use these in Docker; keep the \n escapes in the key)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
